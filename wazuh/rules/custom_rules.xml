<?xml version="1.0" encoding="UTF-8"?>
<!--
================================================================================
Mini SOC - Custom Detection Rules for DVWA
================================================================================

Description:
  This rule file contains custom detection patterns for identifying various
  types of web application attacks targeting DVWA through HTTP requests.
  
  Rules are categorized by attack type and severity level.
  
  Severity Levels:
  - 7-8: MEDIUM (investigate within 2 hours)
  - 9: HIGH (investigate within 30 minutes)
  - 10: CRITICAL (immediate action required)

Author: Mini SOC Team - Kelas C (032-042-050)
Created: 2026-04-25
Last Updated: 2026-04-25

================================================================================
-->

<group name="webapp,dvwa,attack,">

  <!-- =====================================================================
       RULE GROUP 1: SQL INJECTION DETECTION
       ===================================================================== -->

  <!-- Rule 100100: SQL Injection - Basic Pattern Matching
       Detects common SQL keywords used in injection attacks
       Impact: Database query manipulation, unauthorized data access
  -->
  <rule id="100100" level="10">
    <decoded_as>web-accesslog</decoded_as>
    <match>UNION|SELECT|union|select</match>
    <description>Possible SQL Injection attempt on DVWA</description>
  </rule>

  <!-- Rule 100101: SQL Injection - OR-based Injection
       Detects OR operator commonly used to bypass authentication
       Payload example: admin' OR '1'='1
       Impact: Authentication bypass
  -->
  <rule id="100101" level="10">
    <decoded_as>web-accesslog</decoded_as>
    <match>' OR | OR '| OR 1| 1'=1</match>
    <description>Possible SQL Injection - OR-based authentication bypass attempt</description>
  </rule>

  <!-- Rule 100102: SQL Injection - Advanced Techniques
       Detects advanced SQLi methods like UNION SELECT, comments, etc.
  -->
  <rule id="100102" level="10">
    <decoded_as>web-accesslog</decoded_as>
    <match>UNION.*SELECT|SELECT.*FROM|-- |;DROP|;DELETE|;UPDATE</match>
    <description>Possible advanced SQL Injection attempt detected</description>
  </rule>

  <!-- Rule 100103: SQL Injection - Error-based Detection
       Detects SQL errors indicating injection vulnerability discovery
  -->
  <rule id="100103" level="9">
    <decoded_as>web-accesslog</decoded_as>
    <status>500</status>
    <match>SQL|mysql|syntax|database</match>
    <description>Possible SQL error-based injection attempt detected</description>
  </rule>

  <!-- =====================================================================
       RULE GROUP 2: CROSS-SITE SCRIPTING (XSS) DETECTION
       ===================================================================== -->

  <!-- Rule 100200: XSS - Script Tag Detection
       Detects <script> tags in HTTP requests (both encoded and plain)
       Impact: Session hijacking, credential theft, malware injection
  -->
  <rule id="100200" level="10">
    <decoded_as>web-accesslog</decoded_as>
    <match>&lt;script&gt;|%3Cscript%3E|&lt;/script&gt;|%3C/script%3E</match>
    <description>Possible XSS attempt - Script tag detected in DVWA</description>
  </rule>

  <!-- Rule 100201: XSS - Event Handler Detection
       Detects JavaScript event handlers (onerror, onclick, onload, etc.)
       Payload example: <img src=x onerror="alert('XSS')">
  -->
  <rule id="100201" level="10">
    <decoded_as>web-accesslog</decoded_as>
    <match>onerror|onclick|onload|onmouseover|onmouseout</match>
    <description>Possible XSS attempt - Event handler detected</description>
  </rule>

  <!-- Rule 100202: XSS - JavaScript Protocol
       Detects javascript: protocol in URLs or event handlers
       Payload example: <a href="javascript:alert()">
  -->
  <rule id="100202" level="10">
    <decoded_as>web-accesslog</decoded_as>
    <match>javascript:|vbscript:|data:text/html</match>
    <description>Possible XSS attempt - JavaScript protocol detected</description>
  </rule>

  <!-- Rule 100203: XSS - Encoded Variants
       Detects HTML entity encoded XSS payloads
       Examples: &#60;script&#62;, &#x3C;script&#x3E;
  -->
  <rule id="100203" level="9">
    <decoded_as>web-accesslog</decoded_as>
    <match>&#\d+;|&#x[0-9a-fA-F]+;</match>
    <description>Possible encoded XSS attempt detected</description>
  </rule>

  <!-- =====================================================================
       RULE GROUP 3: FILE UPLOAD & EXECUTION DETECTION
       ===================================================================== -->

  <!-- Rule 100300: File Upload - PHP File Execution
       Detects upload or execution of PHP files
       Impact: Remote code execution (RCE)
  -->
  <rule id="100300" level="10">
    <decoded_as>web-accesslog</decoded_as>
    <url>/vulnerabilities/upload/</url>
    <match>.php|.phtml|.php5|.phar</match>
    <description>Possible PHP file upload attempt on DVWA - RCE risk</description>
  </rule>

  <!-- Rule 100301: Suspicious PHP File Access
       Detects direct access to uploaded PHP files
  -->
  <rule id="100301" level="7">
    <decoded_as>web-accesslog</decoded_as>
    <match>.php</match>
    <description>Suspicious PHP file access detected</description>
  </rule>

  <!-- Rule 100302: Executable File Upload Attempt
       Detects upload attempts of executable files (.exe, .sh, .bat, etc.)
  -->
  <rule id="100302" level="9">
    <decoded_as>web-accesslog</decoded_as>
    <match>.exe|.bin|.sh|.bat|.cmd|.scr</match>
    <description>Possible executable file upload attempt detected</description>
  </rule>

  <!-- =====================================================================
       RULE GROUP 4: BRUTE FORCE DETECTION
       ===================================================================== -->

  <!-- Rule 100400: Brute Force - Multiple Failed Attempts
       Detects multiple failed login attempts from same source
       Threshold: 5 failed attempts within 5 minutes
  -->
  <rule id="100400" level="10">
    <decoded_as>web-accesslog</decoded_as>
    <url>/vulnerabilities/brute/</url>
    <status>401|403</status>
    <frequency>5 in 5m</frequency>
    <timeframe>300</timeframe>
    <same_source_ip>yes</same_source_ip>
    <description>Possible brute force login attack detected - Multiple failed attempts</description>
  </rule>

  <!-- Rule 100401: Brute Force - High Frequency Requests
       Detects rapid login attempt sequences
       Threshold: 10 attempts within 1 minute
  -->
  <rule id="100401" level="9">
    <decoded_as>web-accesslog</decoded_as>
    <url>/vulnerabilities/brute/</url>
    <frequency>10 in 1m</frequency>
    <timeframe>60</timeframe>
    <same_source_ip>yes</same_source_ip>
    <description>High-frequency login attempts detected - Possible brute force attack</description>
  </rule>

  <!-- =====================================================================
       RULE GROUP 5: RECONNAISSANCE & SCANNING DETECTION
       ===================================================================== -->

  <!-- Rule 100500: Excessive Request Volume
       Detects potential scanning/enumeration activity
       Threshold: 50 requests within 1 minute
  -->
  <rule id="100500" level="8">
    <decoded_as>web-accesslog</decoded_as>
    <frequency>50 in 1m</frequency>
    <timeframe>60</timeframe>
    <same_source_ip>yes</same_source_ip>
    <description>Possible scanning activity detected - Excessive request volume</description>
  </rule>

  <!-- Rule 100501: Suspicious User-Agent Detection
       Detects common scanning and exploitation tools
  -->
  <rule id="100501" level="7">
    <decoded_as>web-accesslog</decoded_as>
    <match>sqlmap|nikto|nmap|masscan|metasploit|burp|owasp|zaproxy</match>
    <description>Possible web scanner/attack tool detected via User-Agent</description>
  </rule>

  <!-- Rule 100502: Directory Traversal Attempt
       Detects attempts to access parent directories
       Payload example: /../../etc/passwd, /..\\..\\windows\\
  -->
  <rule id="100502" level="9">
    <decoded_as>web-accesslog</decoded_as>
    <match>\.\./|\.\.\\|\.\.%2f|\.\.%5c|%2e%2e|\.\.\.\.\/</match>
    <description>Possible directory traversal attack detected</description>
  </rule>

  <!-- =====================================================================
       RULE GROUP 6: COMMAND INJECTION DETECTION
       ===================================================================== -->

  <!-- Rule 100600: OS Command Injection
       Detects shell metacharacters used in command injection
  -->
  <rule id="100600" level="10">
    <decoded_as>web-accesslog</decoded_as>
    <match>;whoami|;cat|;ls|;id|`whoami`|$(whoami)|;nc|;bash|;sh</match>
    <description>Possible OS command injection attempt detected</description>
  </rule>

  <!-- Rule 100601: Shell Metacharacter Detection
       Detects shell control characters that could indicate injection
  -->
  <rule id="100601" level="8">
    <decoded_as>web-accesslog</decoded_as>
    <match>%3B|%26|%7C|%24%28|%60|%26%26|%7C%7C</match>
    <description>Possible command injection - Shell metacharacters detected</description>
  </rule>

  <!-- =====================================================================
       RULE GROUP 7: ADVANCED ATTACK PATTERNS (COMPOSITE RULES)
       ===================================================================== -->

  <!-- Rule 100700: Rapid Multi-Vector Attack
       Detects when multiple attack types occur from same source
       Composite: SQLi + XSS in quick succession
  -->
  <rule id="100700" level="12">
    <if_sid>100100,100200</if_sid>
    <timeframe>60</timeframe>
    <same_source_ip>yes</same_source_ip>
    <frequency>2 in 1m</frequency>
    <description>Advanced attack detected - Multiple attack vectors from single source</description>
  </rule>

  <!-- Rule 100701: Persistent Attack Pattern
       Detects repeated attack attempts indicating advanced attacker
  -->
  <rule id="100701" level="11">
    <if_sid>100100</if_sid>
    <frequency>10 in 1h</frequency>
    <timeframe>3600</timeframe>
    <same_source_ip>yes</same_source_ip>
    <description>Persistent attack detected - SQLi attempts over extended period</description>
  </rule>

  <!-- =====================================================================
       RULE GROUP 8: INFORMATION DISCLOSURE
       ===================================================================== -->

  <!-- Rule 100800: Database Error Exposure
       Detects database error messages which disclose system information
  -->
  <rule id="100800" level="7">
    <decoded_as>web-accesslog</decoded_as>
    <status>500</status>
    <match>mysql_fetch|mysql_error|mysqli|pdo.*error</match>
    <description>Possible information disclosure - Database error exposed</description>
  </rule>

  <!-- Rule 100801: Sensitive Path Access
       Detects attempts to access sensitive/hidden directories
  -->
  <rule id="100801" level="7">
    <decoded_as>web-accesslog</decoded_as>
    <match>.git/|.svn/|.env|config.php|database.php|settings.ini</match>
    <description>Possible information disclosure - Sensitive file access attempt</description>
  </rule>

  <!-- =====================================================================
       RULE GROUP 9: SUCCESSFUL EXPLOITATION INDICATORS
       ===================================================================== -->

  <!-- Rule 100900: Successful SQLi Exploitation
       Detects when SQLi returns data (200 OK with content)
  -->
  <rule id="100900" level="11">
    <if_sid>100100</if_sid>
    <status>200</status>
    <description>SQLi attack successful - Unauthorized data accessed</description>
  </rule>

  <!-- Rule 100901: Successful XSS Exploitation
       Detects when XSS payload is reflected in response (200 OK)
  -->
  <rule id="100901" level="11">
    <if_sid>100200</if_sid>
    <status>200</status>
    <description>XSS attack successful - Script payload reflected in response</description>
  </rule>

  <!-- Rule 100902: Successful File Upload
       Detects when malicious file is uploaded successfully
  -->
  <rule id="100902" level="11">
    <if_sid>100300</if_sid>
    <status>200|301|302</status>
    <description>File upload successful - Potential RCE achieved</description>
  </rule>

  <!-- =====================================================================
       RULE GROUP 10: POLICY VIOLATIONS & COMPLIANCE
       ===================================================================== -->

  <!-- Rule 100920: Repeated False Positive Prevention
       Suppresses alerts for known false positive patterns
  -->
  <rule id="100920" level="0">
    <if_sid>100301</if_sid>
    <url>/index.php|/login.php|/dashboard.php|/api</url>
    <description>Legitimate PHP access - Whitelisted</description>
  </rule>

</group>

<!-- 
================================================================================
NOTES FOR RULE MANAGEMENT
================================================================================

1. RULE TESTING:
   Before deploying new rules to production, test them with:
   - Manual log injection
   - Actual attack execution
   - Verify detection within 1 minute
   
2. FALSE POSITIVE MANAGEMENT:
   - Monitor alert rate
   - Create exception rules for whitelisted paths
   - Adjust frequency thresholds if needed
   
3. RULE UPDATES:
   - Update rules when new attack patterns emerge
   - Review monthly for optimization
   - Maintain version control of changes
   
4. PERFORMANCE CONSIDERATIONS:
   - Complex regex patterns impact performance
   - Test on staging first
   - Monitor Wazuh Manager CPU/memory usage
   
5. DOCUMENTATION:
   - Keep each rule well-documented
   - Include examples of matching payloads
   - Note severity justification
   - List related CVEs if applicable

6. ESCALATION PROCEDURES:
   Rules with level 10+ should trigger:
   - Immediate notification to SOC
   - Incident ID generation
   - Automated containment (if configured)
   - Manual investigation required

================================================================================
-->
