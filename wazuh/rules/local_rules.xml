<!-- Custom Rules -->
<!--
================================================================================
Mini SOC - Custom Detection Rules for DVWA
================================================================================

Description:
  This rule file contains custom detection patterns for identifying various
  types of web application attacks targeting DVWA through HTTP requests.
  
  Rules are categorized by attack type and severity level.
  
  Severity Levels:
  - 7-8: MEDIUM (investigate within 2 hours)
  - 9: HIGH (investigate within 30 minutes)
  - 10: CRITICAL (immediate action required)

Author: Mini SOC Team - Kelas C (032-042-050)
Created: 2026-04-25
Last Updated: 2026-04-25

================================================================================
-->
<group name="webapp,dvwa,attack,">

  <!-- =====================================================================
       RULE GROUP 1: SQL INJECTION DETECTION
       ===================================================================== -->

  <rule id="100100" level="12">
    <if_sid>31105</if_sid>
    <url>/vulnerabilities/sqli/</url>
    <description>DVWA: SQL Injection attempt detected (Refined Rule)</description>
  </rule>

  <!-- =====================================================================
       RULE GROUP 2: CROSS-SITE SCRIPTING (XSS) DETECTION
       ===================================================================== -->

  <rule id="100200" level="12">
    <if_sid>31102</if_sid>
    <url>/vulnerabilities/xss_r/|/vulnerabilities/xss_s/|/vulnerabilities/xss_d/</url>
    <description>DVWA: XSS attempt detected (Refined Rule)</description>
  </rule>

  <!-- =====================================================================
       RULE GROUP 3: FILE UPLOAD DETECTION
       ===================================================================== -->

  <rule id="100300" level="10">
    <if_sid>31108</if_sid>
    <url>/vulnerabilities/upload/</url>
    <protocol>^POST$</protocol>
    <description>DVWA: File upload attempt detected</description>
  </rule>

  <!-- =====================================================================
       RULE GROUP 4: BRUTE FORCE DETECTION
       ===================================================================== -->

  <!-- Base rule to match any POST to the brute force page -->
  <rule id="100400" level="3">
    <if_sid>31108</if_sid>
    <url>/vulnerabilities/brute/</url>
    <protocol>^POST$</protocol>
    <description>DVWA: Login attempt on brute force page</description>
  </rule>

  <!-- High frequency alert rule -->
  <rule id="100401" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100400</if_matched_sid>
    <same_source_ip />
    <description>DVWA: Brute force attack detected (Multiple attempts)</description>
  </rule>

</group>

